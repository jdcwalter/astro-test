<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Birthday Wishlist!</title>

  <style>
    body {
      background-color: #00ffff;
      background-image:
        linear-gradient(45deg, #ff66cc 25%, transparent 25%),
        linear-gradient(-45deg, #ff66cc 25%, transparent 25%);
      background-size: 40px 40px;

      font-family: "Comic Sans MS", "Arial", sans-serif;
      color: #000080;
      margin: 0;
      padding: 20px;
    }

    .page {
      width: 760px;
      max-width: 90%;
      margin: 0 auto;
      background: #ffffcc;
      border: 6px ridge #ff00ff;
      padding: 20px;
    }

    h1 {
      text-align: center;
      color: #ff0000;
      font-size: 42px;
      text-shadow: 3px 3px #ffff00;
      margin-bottom: 5px;
    }

    .subtitle {
      text-align: center;
      font-size: 18px;
      font-weight: bold;
    }

    marquee {
      background: #000080;
      color: #ffff00;
      padding: 8px;
      font-weight: bold;
      margin: 15px 0;
    }

    .wishlist-item {
      display: flex;
      gap: 20px;
      align-items: center;

      background: #ffffff;
      border: 4px outset #c0c0c0;
      padding: 15px;
      margin: 20px 0;
    }

    .wishlist-item img {
      width: 180px;
      height: 180px;
      object-fit: contain;
      border: 3px solid #000080;
      background: white;
    }

    .item-info {
      flex: 1;
    }

    .item-info h2 {
      color: #800080;
      margin-top: 0;
    }

    .buy-button {
      display: inline-block;
      background: #c0c0c0;
      border: 4px outset #ffffff;
      color: #000000;
      font-weight: bold;
      text-decoration: none;
      padding: 10px 16px;
      margin-top: 8px;
    }

    .buy-button:active {
      border-style: inset;
    }

    .footer {
      text-align: center;
      margin-top: 30px;
      font-size: 14px;
    }

    .blink {
      animation: blink 0.8s step-start infinite;
    }

    @keyframes blink {
      50% {
        visibility: hidden;
      }
    }

    @media (max-width: 600px) {
      .wishlist-item {
        display: block;
        text-align: center;
      }

      .wishlist-item img {
        width: 80%;
        height: auto;
      }

      h1 {
        font-size: 30px;
      }
    }
  </style>
</head>

<body>

  <div class="page">

     <a href="/">Home</a>
    
